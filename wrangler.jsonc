{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placar-da-verdade",
  "main": "worker.js",
  "routes": [
    { "pattern": "placardaverdade.com.br", "custom_domain": true },
    { "pattern": "www.placardaverdade.com.br", "custom_domain": true },
    // domínio antigo: um Redirect Rule da zona zenithonacademy.com.br manda tudo para placardaverdade.com.br
    { "pattern": "placar.zenithonacademy.com.br", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    // Só /ao-vivo chega no Worker. Qualquer outro endereço (até os inexistentes) é respondido pelos
    // arquivos estáticos, que são grátis e ilimitados: flood de URL aleatória não gasta a cota do Worker
    "run_worker_first": ["/ao-vivo", "/contestar"],
    "not_found_handling": "404-page"
  },
  // "Achou erro?": cada aviso vira uma chave no KV (ler com: npm run contestacoes)
  "kv_namespaces": [{ "binding": "CONTESTACOES", "id": "e3c32a3d78354cd997f346e212ed6df5" }],
  // Limite por IP no envio de avisos (spam)
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "CONTADOR", "class_name": "Contador" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Contador"] }]
}
